# Copy to .env and fill in. .env is gitignored; never commit real keys.
GEMINI_API_KEY=
# Optional: several keys (one per Google Cloud project = separate free quotas).
# On a 429 the brain rotates to the next one. Overrides GEMINI_API_KEY if set.
# GEMINI_API_KEYS=key1,key2,key3
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Optional overrides (defaults shown)
# GEMINI_FLASH_MODEL=gemini-3.8-flash
# GEMINI_ALT_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash   # fallbacks, in order
# GEMINI_PRO_MODEL=                                     # paid keys only, e.g. gemini-3.1-pro-preview (0 free requests/day)
# PRO_FALLBACK_BELOW=0.7
# FLASH_THINKING=low          # low | medium | high  (minimal is rejected by 3.8-flash)
# PRO_THINKING=medium
# GEMINI_TIMEOUT_S=35
# GEMINI_MOCK=0               # 1 = canned verdicts, no Gemini calls (build robot/voice/app without quota)
# MOCK_CASE=cycle             # cycle | wrong_rule | correct | arithmetic
# PREFER_CACHE=0              # 1 = serve brain/demo_cache hits before calling Gemini (rehearsed demo)
# SPEAK_THRESHOLD=0.7
# COOLDOWN_S=20
# STILL_S=5                   # board must hold still this long before an auto-check
# MIN_CHECK_INTERVAL_S=12     # at most one auto-check this often (quota guard)
# CHANGE_THR=0.0001           # fraction of pixels that must change to re-check (raise if lighting flicker triggers checks)
# STUCK_AFTER_S=60
# STUCK_PROMPT=Take your time. Ask me to check whenever you're ready.   # empty = face only
# CAMERA_ENABLED=1
# CAMERA_INDEX=auto           # auto = external USB webcam; or a /dev/videoN number
# CAMERA_NAME=WEB CAM         # optional: pick the device whose name contains this
# CAMERA_W=1920
# CAMERA_H=1080
# JPEG_MAX_W=1600             # width of the image sent to Gemini; lower = faster, less legible
# BOARD_DETECT=1              # 0 = send the whole frame instead of the detected whiteboard
# BRAIN_PORT=8000

# Stretch sponsors
# TIGER_DSN=postgres://...
# SNOWFLAKE_ACCOUNT=
# SOLANA_RPC=https://api.devnet.solana.com
